#version 140

// Vertex shader of the fullscreen quad: the room and every post-processing pass.

uniform vx_uniforms {
  mat4 view_proj;
};

in vec4 position;
in vec2 texcoord0;

out vec2 var_texcoord0;

void main() {
  gl_Position = view_proj * vec4(position.xyz, 1.0);
  var_texcoord0 = texcoord0;
}
